# Copy to .env and fill in. .env is gitignored; keep it that way.

# Agent-scoped Inkbox keys, one per identity. Already in your Windows user
# environment as INKBOX_KEY_* from the setup script.
INKBOX_KEY_THEWORLDOFAI=
INKBOX_KEY_SRJ=
INKBOX_KEY_COORDINATOR=

# Webhook signing secrets. Produced by bootstrap.py, printed once by Inkbox and
# never retrievable again. Without these the receiver returns 503 rather than
# trusting an unverified payload.
INKBOX_SIGNING_THEWORLDOFAI=
INKBOX_SIGNING_SRJ=
INKBOX_SIGNING_COORDINATOR=

# srj-audit-db. Use the EXTERNAL connection string: this container is not on
# Render, it reaches the database from your home IP, which is the single entry
# on that database's allow list.
DATABASE_URL=

# Local port the tunnels forward to inside the container. Not published.
GATEWAY_PORT=8080
